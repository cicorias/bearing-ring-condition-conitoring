@baseUrl = http://127.0.0.1:8000

### Predict a healthy baseline
POST {{baseUrl}}/v1/predict
Content-Type: application/json
Accept: application/json

< ../../artifacts/grinder-diagnostics-model/samples/baseline.json

> {%
  client.test("Healthy sample stops downstream analysis", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.request_id === "sample-baseline", "Expected baseline request ID");
    client.assert(response.body.has_fault === false, "Expected a healthy classification");
    client.assert(response.body.fault_type === null, "Expected no fault type");
    client.assert(
      response.body.downstream_analysis_required === false,
      "Healthy cycles must not trigger downstream analysis"
    );
    client.assert(
      typeof response.body.binary_probability === "number",
      "Expected numeric binary probability"
    );
    client.assert(response.body.provenance.feature_table_sha256, "Expected provenance hash");
  });
%}

### Predict workhead drive-belt damage
POST {{baseUrl}}/v1/predict
Content-Type: application/json
Accept: application/json

< ../../artifacts/grinder-diagnostics-model/samples/workhead_drive_belt_damage.json

> {%
  client.test("Drive-belt damage is identified", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.has_fault === true, "Expected fault detection");
    client.assert(
      response.body.fault_type === "workhead_drive_belt_damage",
      "Expected workhead drive-belt damage"
    );
    client.assert(
      response.body.downstream_analysis_required === true,
      "Faults must trigger downstream analysis"
    );
  });
%}

