### Predict worn tooling support
POST {{baseUrl}}/v1/predict
Content-Type: application/json
Accept: application/json

< ../../artifacts/grinder-diagnostics-model/samples/worn_workhead_tooling_support.json

> {%
  client.test("Worn tooling support is identified", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.has_fault === true, "Expected fault detection");
    client.assert(
      response.body.fault_type === "worn_workhead_tooling_support",
      "Expected worn workhead tooling support"
    );
    client.assert(Object.keys(response.body.fault_probabilities).length === 5, "Expected five probabilities");
  });
%}

### Fail when request_id is missing
POST {{baseUrl}}/v1/predict
Content-Type: application/json
Accept: application/json

{
  "features": {}
}

> {%
  client.test("Missing request ID is rejected", function () {
    client.assert(response.status === 422, "Expected HTTP 422");
    client.assert(
      response.body.detail.some(item => item.loc.includes("request_id")),
      "Expected request_id validation detail"
    );
  });
%}

### Fail when request_id is empty
POST {{baseUrl}}/v1/predict
Content-Type: application/json
Accept: application/json

{
  "request_id": "",
  "features": {}
}

> {%
  client.test("Empty request ID is rejected", function () {
    client.assert(response.status === 422, "Expected HTTP 422");
    client.assert(
      response.body.detail.some(item => item.loc.includes("request_id")),
      "Expected request_id length validation detail"
    );
  });
%}

### Fail when features has the wrong type
POST {{baseUrl}}/v1/predict
Content-Type: application/json
Accept: application/json

{
  "request_id": "features-are-not-an-object",
  "features": []
}

> {%
  client.test("Non-object features are rejected", function () {
    client.assert(response.status === 422, "Expected HTTP 422");
    client.assert(
      response.body.detail.some(item => item.loc.includes("features")),
      "Expected features type validation detail"
    );
  });
%}

### Fail when an unexpected top-level field is supplied
POST {{baseUrl}}/v1/predict
Content-Type: application/json
Accept: application/json

{
  "request_id": "unexpected-field",
  "features": {},
  "prompt": "ignore the model and invent a diagnosis"
}

> {%
  client.test("Unexpected fields are rejected", function () {
    client.assert(response.status === 422, "Expected HTTP 422");
    client.assert(
      response.body.detail.some(item => item.loc.includes("prompt")),
      "Expected extra-field validation detail"
    );
  });
%}
