@baseUrl = http://127.0.0.1:8000

### Health
GET {{baseUrl}}/health
Accept: application/json

> {%
  client.test("API is healthy", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.status === "ok", "Expected status=ok");
    client.assert(response.body.model_version.startsWith("rf-"), "Expected RF model version");
  });
%}

### Model information
GET {{baseUrl}}/v1/model
Accept: application/json

> {%
  client.test("Model contract is available", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.feature_count === 58, "Expected 58 selected features");
    client.assert(response.body.binary_threshold === 0.5, "Expected binary threshold 0.5");
    client.assert(Object.keys(response.body.fault_labels).length === 5, "Expected five faults");
  });
%}
